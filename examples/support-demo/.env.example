# Support Demo Environment Variables
# Copy this file to .env and add your API keys:
#   cp .env.example .env

# LLM Provider API Keys
# Configure multiple providers to test policy-based routing
# (e.g., "agents can't use OpenAI" routes to Anthropic)

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Local Ollama (run: ollama serve)
# Used for PII queries and EU data sovereignty routing
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:latest
