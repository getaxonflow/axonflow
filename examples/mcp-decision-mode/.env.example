# AxonFlow MCP Decision Mode example — copy to .env and edit.
#   cp .env.example .env

# AxonFlow agent (the Policy Decision Point). The bundled docker-compose
# stack publishes the agent on :8080.
AXONFLOW_AGENT_URL=http://localhost:8080

# Basic-auth credentials for the agent. In enterprise mode CLIENT_SECRET is
# the license key, and CLIENT_ID / TENANT_ID are your AxonFlow org identifier.
# Replace these with the values your AxonFlow deployment issued for your organization.
AXONFLOW_CLIENT_ID=mcp-decision-mode-demo
AXONFLOW_CLIENT_SECRET=replace-with-license-key
AXONFLOW_TENANT_ID=mcp-decision-mode-demo

# The leader operating Claude Code on this laptop. Forwarded to the PDP as
# x-leader-identity and recorded in the Layer 1 audit row (leader_email).
MCP_LEADER_EMAIL=leader@example.com

# Failure posture when the PDP is unreachable. "true" (default) = fail-closed:
# block the tool. Set "false" only for non-regulated, availability-first paths.
MCP_FAIL_CLOSED=true

# Where the Layer 1 audit log is written (one JSON object per line).
MCP_AUDIT_LOG_PATH=audit_log.jsonl
