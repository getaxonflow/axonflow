# AxonFlow Workflow Policy Examples - Environment Configuration

# AxonFlow Agent endpoint (required)
AXONFLOW_ENDPOINT=http://localhost:8080

# Client credentials (required)
AXONFLOW_CLIENT_ID=your-client-id
AXONFLOW_CLIENT_SECRET=your-client-secret

# Agent endpoint for MAP examples (optional)
AXONFLOW_AGENT_URL=http://localhost:8080
