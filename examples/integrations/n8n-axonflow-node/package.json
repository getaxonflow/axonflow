{
  "name": "n8n-nodes-axonflow",
  "version": "0.2.0",
  "description": "AxonFlow API integration for n8n — call AxonFlow policy and HITL endpoints from your workflows.",
  "keywords": [
    "n8n-community-node-package",
    "axonflow",
    "policy",
    "hitl"
  ],
  "license": "MIT",
  "homepage": "https://github.com/getaxonflow/axonflow-enterprise/tree/main/examples/integrations/n8n-axonflow-node",
  "author": {
    "name": "AxonFlow",
    "email": "hello@getaxonflow.com",
    "url": "https://getaxonflow.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getaxonflow/axonflow-enterprise.git",
    "directory": "examples/integrations/n8n-axonflow-node"
  },
  "engines": {
    "node": ">=18.10"
  },
  "scripts": {
    "build": "tsc && node ./scripts/copy-assets.js",
    "lint": "eslint nodes credentials package.json",
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "format": "prettier nodes credentials --write",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "examples"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/AxonFlowApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/AxonFlow/AxonFlow.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "n8n-workflow": "^1.82.0",
    "prettier": "^3.3.3",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0"
  }
}
