FROM golang:1.26-alpine AS builder
RUN apk add --no-cache ca-certificates
WORKDIR /build
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /adapter ./cmd/adapter/

FROM alpine:3.21
RUN apk add --no-cache ca-certificates && \
    addgroup -g 1001 -S adapter && \
    adduser -S -D -H -u 1001 -G adapter adapter
COPY --from=builder /adapter /usr/local/bin/adapter
USER adapter
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:8888/health || true
ENTRYPOINT ["adapter"]
