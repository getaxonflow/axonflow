# AxonFlow Workflow Control Plane Example - Environment Variables

# AxonFlow Agent URL
AXONFLOW_AGENT_URL=http://localhost:8080

# OAuth2 Client Credentials (optional for Community mode)
AXONFLOW_CLIENT_ID=workflow-control-example
AXONFLOW_CLIENT_SECRET=

# Alternative names (for compatibility)
AXONFLOW_ENDPOINT=http://localhost:8080
