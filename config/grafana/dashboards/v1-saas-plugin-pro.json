    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Plugin-claim license rows whose issued_at falls in the current UTC day. Resets to 0 at midnight UTC. Sourced from the 60s background poller in platform/agent/plugin_license_metrics.go (gauge: axonflow_plugin_licenses_issued_today_total).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.2.2",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(axonflow_plugin_licenses_issued_today_total)",
          "legendFormat": "claims today",
          "refId": "A"
        }
      ],
      "title": "Claims Today",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Estimated forward-looking 90-day MRR. V1 SaaS Plugin Pro is one-time-payment ($9.99 / 90 days), not subscription, so this is NOT committed recurring revenue — it's the dollar value of currently-active Pro entitlements that will be delivered over the next 90 days. Formula: $9.99 × axonflow_plugin_licenses_active_total. After the 90-day window each license drops to Free unless re-purchased. Use the Active Pro Tenants panel + the expirations panel to see the renewal cliff.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.2.2",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(axonflow_plugin_licenses_active_total) * 9.99",
          "legendFormat": "MRR (90d forward)",
          "refId": "A"
        }
      ],
      "title": "MRR (90d Forward Estimate)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
