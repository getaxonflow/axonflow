      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (result) (rate(axonflow_agent_plugin_claim_validations_total{result!=\"absent\"}[5m])) * 60",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "title": "Plugin-claim middleware validations (excl. absent)",
      "type": "timeseries"
    },
