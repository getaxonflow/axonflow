    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Plugin-claim middleware validation outcomes. 'valid' is the happy path. 'invalid_token' or 'tenant_mismatch' surging suggests forgery attempts. 'not_found' or 'revoked' spikes can indicate billing/agent DB drift or aggressive revocation. 'db_error'/'db_unavailable' indicate operational issues. 'absent' is free-tier traffic (no X-License-Token sent).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "rate per minute",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
