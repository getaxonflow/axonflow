          {
            "expr": "axonflow_agent_total_requests",
            "legendFormat": "Total",
            "refId": "A"
          },
          {
            "expr": "axonflow_agent_success_requests_total",
            "legendFormat": "Success",
            "refId": "B"
          },
          {
            "expr": "axonflow_agent_failed_requests_total",
            "legendFormat": "Failed",
            "refId": "C"
          },
          {
            "expr": "axonflow_agent_blocked_requests_total",
            "legendFormat": "Blocked",
            "refId": "D"
