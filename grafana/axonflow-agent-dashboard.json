        "yaxes": [
          {
            "label": "Requests",
            "show": true,
            "min": 0
          },
          {
            "show": true
          }
        ],
        "xaxis": {
          "show": true,
          "mode": "time"
        },
        "lines": true,
        "fill": 2,
        "linewidth": 1,
        "nullPointMode": "null",
        "stack": true,
        "aliasColors": {
          "Total": "#1f78c1",
          "Success": "#7eb26d",
          "Failed": "#bf1b00",
          "Blocked": "#e5ac0e"
