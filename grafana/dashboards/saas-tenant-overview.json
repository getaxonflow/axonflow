{
  "title": "SaaS Tenant Overview",
  "uid": "saas-tenant-overview",
  "description": "Tenant-scoped metrics dashboard for SaaS deployments. Shows API usage, token consumption, costs, and performance metrics per tenant.",
  "tags": [
    "saas",
    "tenant",
    "usage",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API Request Volume",
      "description": "Total API requests per minute by endpoint for the selected tenant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(axonflow_agent_requests_total{tenant_id=~\"$tenant_id\"}[5m])) by (endpoint) * 60",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "rpm",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data available"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Token Consumption",
      "description": "LLM tokens consumed over time by model for the selected tenant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(axonflow_orchestrator_tokens_consumed_total{tenant_id=~\"$tenant_id\"}[1h])) by (model)",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data available"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum",
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Total Requests (24h)",
      "description": "Total API requests in the last 24 hours",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(axonflow_agent_requests_total{tenant_id=~\"$tenant_id\"}[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "blue"
              },
              {
                "value": 1000,
                "color": "green"
              },
              {
                "value": 10000,
                "color": "purple"
              }
            ]
          },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Total Tokens (24h)",
      "description": "Total LLM tokens consumed in the last 24 hours",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(axonflow_orchestrator_tokens_consumed_total{tenant_id=~\"$tenant_id\"}[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "blue"
              }
            ]
          },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Estimated Cost (24h)",
      "description": "Estimated LLM costs for the last 24 hours",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(axonflow_orchestrator_provider_total_cost{tenant_id=~\"$tenant_id\"}[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 10,
                "color": "yellow"
              },
              {
                "value": 100,
                "color": "orange"
              },
              {
                "value": 1000,
                "color": "red"
              }
            ]
          },
          "noValue": "$0.00"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Error Rate",
      "description": "Current error rate (4xx/5xx responses)",
      "type": "gauge",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(axonflow_agent_requests_total{tenant_id=~\"$tenant_id\", status_code=~\"[45]..\"}[5m])) / sum(rate(axonflow_agent_requests_total{tenant_id=~\"$tenant_id\"}[5m])) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 1,
                "color": "yellow"
              },
              {
                "value": 5,
                "color": "orange"
              },
              {
                "value": 10,
                "color": "red"
              }
            ]
          },
          "noValue": "0%"
        }
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 7,
      "title": "Cost Trends",
      "description": "Daily cost trends for the selected tenant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(axonflow_orchestrator_provider_total_cost{tenant_id=~\"$tenant_id\"}[1d]))",
          "legendFormat": "Daily Cost",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "gradientMode": "scheme",
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "currencyUSD",
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "noValue": "No data available"
        }
      },
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum",
            "mean"
          ]
        }
      }
    },
    {
      "id": 8,
      "title": "Policy Evaluations",
      "description": "Policy evaluation pass/fail rates",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(axonflow_orchestrator_policy_evaluations_total{tenant_id=~\"$tenant_id\", result=\"pass\"}[5m])) * 60",
          "legendFormat": "Pass",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(axonflow_orchestrator_policy_evaluations_total{tenant_id=~\"$tenant_id\", result=\"fail\"}[5m])) * 60",
          "legendFormat": "Fail",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 30,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "rpm",
          "noValue": "No data available"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pass"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fail"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum",
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "Error Rate by Endpoint",
      "description": "4xx and 5xx error rates broken down by API endpoint",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(axonflow_agent_requests_total{tenant_id=~\"$tenant_id\", status_code=~\"4..\"}[5m])) by (endpoint) * 60",
          "legendFormat": "4xx - {{endpoint}}",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(axonflow_agent_requests_total{tenant_id=~\"$tenant_id\", status_code=~\"5..\"}[5m])) by (endpoint) * 60",
          "legendFormat": "5xx - {{endpoint}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "rpm",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No errors"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum",
            "max"
          ]
        }
      }
    },
    {
      "id": 10,
      "title": "Latency Percentiles",
      "description": "Response time percentiles (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(axonflow_agent_request_duration_seconds_bucket{tenant_id=~\"$tenant_id\"}[5m])) by (le)) * 1000",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(axonflow_agent_request_duration_seconds_bucket{tenant_id=~\"$tenant_id\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(axonflow_agent_request_duration_seconds_bucket{tenant_id=~\"$tenant_id\"}[5m])) by (le)) * 1000",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data available"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 11,
      "title": "Policy Pass Rate",
      "description": "Overall policy evaluation pass rate",
      "type": "gauge",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(axonflow_orchestrator_policy_evaluations_total{tenant_id=~\"$tenant_id\", result=\"pass\"}[24h])) / sum(rate(axonflow_orchestrator_policy_evaluations_total{tenant_id=~\"$tenant_id\"}[24h])) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 80,
                "color": "yellow"
              },
              {
                "value": 95,
                "color": "green"
              }
            ]
          },
          "noValue": "N/A"
        }
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 12,
      "title": "Top Endpoints by Request Volume",
      "description": "Most frequently called API endpoints",
      "type": "bargauge",
      "gridPos": {
        "h": 5,
        "w": 9,
        "x": 6,
        "y": 28
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "topk(5, sum(increase(axonflow_agent_requests_total{tenant_id=~\"$tenant_id\"}[24h])) by (endpoint))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 13,
      "title": "Cost by Model",
      "description": "LLM costs broken down by model",
      "type": "piechart",
      "gridPos": {
        "h": 5,
        "w": 9,
        "x": 15,
        "y": 28
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(axonflow_orchestrator_provider_total_cost{tenant_id=~\"$tenant_id\"}[24h])) by (model)",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        }
      },
      "options": {
        "pieType": "donut",
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        },
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(axonflow_agent_requests_total, tenant_id)",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Tenant",
        "multi": false,
        "options": [],
        "refresh": 2,
        "regex": "",
        "sort": 1
      },
      {
        "name": "timeRange",
        "type": "interval",
        "query": "1h,6h,12h,24h,7d,30d",
        "current": {
          "text": "24h",
          "value": "24h"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Time Range",
        "multi": false,
        "options": [],
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": "Prometheus",
        "enable": true,
        "expr": "changes(axonflow_deployment_timestamp{tenant_id=~\"$tenant_id\"}[1m]) > 0",
        "hide": false,
        "iconColor": "blue",
        "name": "Deployment Events",
        "titleFormat": "Deployment",
        "textFormat": "New deployment detected"
      },
      {
        "datasource": "Prometheus",
        "enable": true,
        "expr": "changes(axonflow_policy_version{tenant_id=~\"$tenant_id\"}[1m]) > 0",
        "hide": false,
        "iconColor": "purple",
        "name": "Policy Changes",
        "titleFormat": "Policy Change",
        "textFormat": "Policy configuration updated"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "Executive Summary",
      "tooltip": "View executive summary dashboard",
      "type": "link",
      "url": "/d/executive-summary/executive-summary"
    }
  ],
  "liveNow": false,
  "style": "dark"
}
