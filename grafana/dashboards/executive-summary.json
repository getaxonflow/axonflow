          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 17,
      "title": "Platform Uptime (30d)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "avg_over_time(axonflow_agent_health_status[30d]) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 99,
                "color": "yellow"
              },
              {
                "value": 99.9,
                "color": "green"
              },
              {
                "value": 99.99,
                "color": "blue"
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 18,
      "title": "License Compliance Status",
      "type": "table",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "targets": [
        {
          "datasource": "PostgreSQL",
          "rawSql": "SELECT \n  COUNT(*) FILTER (WHERE excess_nodes > 0 AND resolved = FALSE) as \"Active Violations\",\n  COUNT(*) FILTER (WHERE excess_nodes > 0) as \"Total Violations (30d)\",\n  ROUND(100.0 - (COUNT(*) FILTER (WHERE excess_nodes > 0 AND resolved = FALSE)::float / NULLIF(COUNT(DISTINCT o.org_id), 0) * 100), 1) as \"Compliance Rate %\"\nFROM organizations o\nLEFT JOIN node_violations nv ON o.org_id = nv.org_id \n  AND nv.violation_start > NOW() - INTERVAL '30 days'\nWHERE o.org_id != 'admin'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Active Violations"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": 0,
                      "color": "green"
                    },
                    {
                      "value": 1,
                      "color": "red"
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Compliance Rate %"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-text"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": 0,
                      "color": "red"
                    },
                    {
                      "value": 95,
                      "color": "yellow"
                    },
                    {
                      "value": 100,
                      "color": "green"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "timeRange",
        "type": "interval",
        "query": "1h,6h,12h,1d,7d,30d",
        "current": {
          "text": "7d",
          "value": "7d"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Time Range",
        "multi": false,
        "options": [],
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
