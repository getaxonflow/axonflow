{
  "title": "In-VPC Platform Overview",
  "uid": "invpc-platform-overview",
  "description": "Platform-wide metrics dashboard for In-VPC deployments. Shows node utilization, service health, infrastructure metrics, and license status.",
  "tags": [
    "invpc",
    "platform",
    "infrastructure",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Node Utilization",
      "description": "Current node count vs maximum allowed by license",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "(axonflow_license_nodes_used / axonflow_license_nodes_max) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 70,
                "color": "yellow"
              },
              {
                "value": 90,
                "color": "orange"
              },
              {
                "value": 100,
                "color": "red"
              }
            ]
          },
          "noValue": "N/A"
        }
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 2,
      "title": "License Status",
      "description": "Days remaining until license expiration",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "(axonflow_license_expiry_timestamp - time()) / 86400",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 30,
                "color": "orange"
              },
              {
                "value": 90,
                "color": "yellow"
              },
              {
                "value": 180,
                "color": "green"
              }
            ]
          },
          "noValue": "N/A"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "title": "Nodes Used / Max",
      "description": "Current nodes vs license limit",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "axonflow_license_nodes_used",
          "legendFormat": "Used",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "axonflow_license_nodes_max",
          "legendFormat": "Max",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "blue"
              }
            ]
          },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "title": "Service Health Status",
      "description": "Health status of all platform services",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "axonflow_agent_health_status",
          "legendFormat": "Agent",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "axonflow_orchestrator_health_status",
          "legendFormat": "Orchestrator",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "axonflow_customer_portal_health_status",
          "legendFormat": "Customer Portal",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "HEALTHY",
                  "color": "green"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNHEALTHY",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "noValue": "UNKNOWN"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 5,
      "title": "Node Health Overview",
      "description": "Count of healthy, unhealthy, and unknown nodes",
      "type": "bargauge",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "count(time() - axonflow_node_heartbeat_timestamp < 60)",
          "legendFormat": "Healthy",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "count(time() - axonflow_node_heartbeat_timestamp >= 60 and time() - axonflow_node_heartbeat_timestamp < 300)",
          "legendFormat": "Degraded",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "count(time() - axonflow_node_heartbeat_timestamp >= 300)",
          "legendFormat": "Unhealthy",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Healthy"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Degraded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unhealthy"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 6,
      "title": "Active Connections",
      "description": "WebSocket and gRPC connections across all nodes",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(axonflow_agent_active_connections)",
          "legendFormat": "WebSocket",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(axonflow_orchestrator_grpc_connections)",
          "legendFormat": "gRPC",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 7,
      "title": "Platform Request Volume",
      "description": "Total API requests per minute across all nodes",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(axonflow_agent_requests_total[5m])) * 60",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rpm",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "blue"
              },
              {
                "value": 100,
                "color": "green"
              },
              {
                "value": 1000,
                "color": "purple"
              }
            ]
          },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 8,
      "title": "CPU Usage by Node",
      "description": "CPU utilization percentage across all nodes",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "axonflow_node_cpu_usage_percent{node_type=~\"$node_type\"}",
          "legendFormat": "{{node_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "Memory Usage by Node",
      "description": "Memory utilization across all nodes",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 11
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "axonflow_node_memory_usage_bytes{node_type=~\"$node_type\"} / 1024 / 1024 / 1024",
          "legendFormat": "{{node_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "decgbytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 10,
      "title": "Node Count by Type",
      "description": "Number of nodes by type (agent/orchestrator)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 11
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "axonflow_agent_node_count{type=\"agent\"}",
          "legendFormat": "Agents",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "axonflow_agent_node_count{type=\"orchestrator\"}",
          "legendFormat": "Orchestrators",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 30,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "0"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 11,
      "title": "Database Connection Pool",
      "description": "Database connection pool status",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "axonflow_db_pool_active_connections",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "axonflow_db_pool_idle_connections",
          "legendFormat": "Idle",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "axonflow_db_pool_max_connections",
          "legendFormat": "Max",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "0"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 12,
      "title": "Database Query Latency",
      "description": "Database query latency percentiles",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(axonflow_db_query_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(axonflow_db_query_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(axonflow_db_query_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never"
          },
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 13,
      "title": "Request Throughput by Service",
      "description": "Request volume breakdown by service",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(axonflow_agent_requests_total{service=~\"$service\"}[5m])) by (service) * 60",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "rpm",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 14,
      "title": "Error Rate by Service",
      "description": "Error rates across platform services",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(axonflow_agent_requests_total{service=~\"$service\", status_code=~\"[45]..\"}[5m])) by (service) / sum(rate(axonflow_agent_requests_total{service=~\"$service\"}[5m])) by (service) * 100",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 30,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 1,
                "color": "yellow"
              },
              {
                "value": 5,
                "color": "red"
              }
            ]
          },
          "noValue": "0%"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 15,
      "title": "Node List",
      "description": "Detailed list of all nodes with health status",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": "PostgreSQL",
          "rawSql": "SELECT \n  h.instance_id as \"Node ID\",\n  h.instance_type as \"Type\",\n  h.hostname as \"Hostname\",\n  h.version as \"Version\",\n  CASE\n    WHEN h.last_heartbeat > NOW() - INTERVAL '1 minute' THEN 'HEALTHY'\n    WHEN h.last_heartbeat > NOW() - INTERVAL '5 minutes' THEN 'DEGRADED'\n    ELSE 'UNHEALTHY'\n  END as \"Status\",\n  h.last_heartbeat as \"Last Heartbeat\",\n  EXTRACT(EPOCH FROM (NOW() - h.last_heartbeat)) as \"Seconds Since Heartbeat\"\nFROM agent_heartbeats h\nWHERE h.last_heartbeat > NOW() - INTERVAL '24 hours'\nORDER BY h.last_heartbeat DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "HEALTHY": {
                        "text": "HEALTHY",
                        "color": "green"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "DEGRADED": {
                        "text": "DEGRADED",
                        "color": "yellow"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "UNHEALTHY": {
                        "text": "UNHEALTHY",
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Seconds Since Heartbeat"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      }
    }
  ],
  "templating": {
