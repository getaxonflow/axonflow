{
  "id": null,
  "uid": "axonflow-performance",
  "title": "AxonFlow Performance - Agent + Orchestrator + End-to-End",
  "tags": [
    "axonflow",
    "agent",
    "orchestrator",
    "performance",
    "slo"
  ],
  "timezone": "utc",
  "schemaVersion": 16,
  "version": 0,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Agent Latency Distribution (P50/P95/P99)",
      "type": "graph",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(axonflow_agent_request_duration_milliseconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "P50 (median)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(axonflow_agent_request_duration_milliseconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(axonflow_agent_request_duration_milliseconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "yaxes": [
        {
          "label": "Milliseconds",
          "show": true,
          "min": 0,
          "max": 50
        },
        {
          "show": true
        }
      ],
      "xaxis": {
        "show": true,
        "mode": "time"
      },
      "lines": true,
      "fill": 1,
      "linewidth": 2,
      "nullPointMode": "null",
      "thresholds": [
        {
          "value": 10,
          "colorMode": "critical",
          "op": "gt",
          "fill": true,
          "line": true
        }
      ],
      "tooltip": {
        "shared": true,
        "sort": 0,
        "value_type": "individual"
      },
      "aliasColors": {
        "P50 (median)": "#7eb26d",
        "P95": "#eab839",
        "P99": "#ef843c"
      }
    },
    {
      "id": 2,
      "title": "Requests Per Second",
      "type": "graph",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(axonflow_agent_requests_total[$__rate_interval]))",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "label": "Requests/sec",
          "show": true,
          "min": 0
        },
        {
          "show": true
        }
      ],
      "xaxis": {
        "show": true,
        "mode": "time"
      },
      "lines": true,
      "fill": 1,
      "linewidth": 2,
      "nullPointMode": "null"
    },
    {
      "id": 3,
      "title": "Success Rate (Target: >99.9%)",
      "type": "graph",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * sum(rate(axonflow_agent_requests_total{status=\"success\"}[$__rate_interval])) / clamp_min(sum(rate(axonflow_agent_requests_total[$__rate_interval])), 1)",
          "legendFormat": "Success Rate (%)",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "label": "Percent",
          "show": true,
          "min": 95,
          "max": 100
        },
        {
          "show": true
        }
      ],
      "xaxis": {
        "show": true,
        "mode": "time"
      },
      "lines": true,
      "fill": 1,
      "linewidth": 2,
      "nullPointMode": "null",
      "thresholds": [
        {
          "value": 99.9,
          "colorMode": "critical",
          "op": "lt",
          "fill": true,
          "line": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Request Breakdown",
      "type": "graph",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(axonflow_agent_requests_total)",
          "legendFormat": "Total",
          "refId": "A"
