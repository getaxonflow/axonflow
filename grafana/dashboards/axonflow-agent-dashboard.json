      "alert": {
        "conditions": [
          {
            "evaluator": {
              "params": [
                1.0
              ],
              "type": "gt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "A",
                "5m",
                "now"
              ]
            },
            "reducer": {
              "type": "avg"
            },
            "type": "query"
          }
        ],
        "frequency": "1m",
        "handler": 1,
        "name": "Error Rate Alert",
        "noDataState": "no_data",
        "notifications": []
      }
