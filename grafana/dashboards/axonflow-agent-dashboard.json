        {
          "expr": "sum(axonflow_agent_requests_total{status=\"success\"})",
          "legendFormat": "Success",
          "refId": "B"
        },
        {
          "expr": "sum(axonflow_agent_requests_total{status=~\"error|orchestrator_error\"})",
          "legendFormat": "Failed",
          "refId": "C"
        },
        {
          "expr": "axonflow_agent_blocked_requests_total",
          "legendFormat": "Blocked",
          "refId": "D"
        }
