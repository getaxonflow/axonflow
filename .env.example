# AxonFlow Local Development Environment Variables
# Copy this file to .env and fill in your API keys

# Docker Compose project name (required for consistent network naming)
# This ensures the network is always 'axonflow_axonflow-network' regardless of directory
COMPOSE_PROJECT_NAME=axonflow

# Deployment mode — REQUIRED on every process that runs the agent or the
# orchestrator, and it must be the SAME value on both.
#
# Since #3096 an UNSET value is no longer treated as "community". The community
# posture disables authentication and license validation and grants tenant-wide
# admin read authority, so it has to be asked for by name; anything else —
# including the empty string and a typo — gets the enterprise posture. The value
# is matched exactly: not trimmed, not case-folded.
#
# An unconfigured deployment still boots. It just stops granting read authority,
# so audit / decisions / cost / replay reads come back 403 or empty.
#
# Values: community | community-saas | evaluation | enterprise | saas
#         in-vpc-enterprise | in-vpc-healthcare | in-vpc-banking | in-vpc-travel
# The bundled docker-compose.yml substitutes this into BOTH services.
DEPLOYMENT_MODE=community

# Browser origins allowed to call the agent, orchestrator and customer-portal
# HTTP APIs directly. Comma-separated (scheme + host + optional port).
#
# `*` is accepted, but credentials are then never advertised — `*` with
# credentials is invalid per the Fetch spec.
#
# An entry containing a `*` — https://*.example.com — is NOT treated as a
# literal string: it is split on the first `*` and matched by prefix and
# suffix, so it admits every subdomain. Such an entry is honoured, but
# credentials are then advertised for NO entry in the list, because it names a
# set nobody enumerated. List exact origins if you need credentialed
# cross-origin requests (#3161).
#
# Unset + DEPLOYMENT_MODE=community  → all origins, no credentials.
#                                      (The customer-portal differs: its API is
#                                      cookie-authenticated and `*` cannot carry
#                                      credentials, so it falls back to
#                                      localhost:3000/:3001 WITH credentials.)
# Unset + any other mode             → ALL cross-origin requests denied.
#
# The Customer Portal UI does not need this: it calls its own Next.js origin and
# is proxied server-side, so it is same-origin.
# AXONFLOW_CORS_ALLOWED_ORIGINS=https://portal.example.com,https://app.example.com

# LLM API Keys (optional for local development)
# Only needed if testing LLM integrations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Azure OpenAI Configuration
# Supports both Classic and Foundry patterns:
#   - Classic: endpoint=https://yourresource.openai.azure.com (uses api-key header)
#   - Foundry: endpoint=https://yourresource.cognitiveservices.azure.com (uses Bearer token)
# Auth type is auto-detected from endpoint URL
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Local LLM Endpoint (optional)
# If running a local LLM (e.g., Ollama, LM Studio)
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest
LOCAL_LLM_ENDPOINT=

# Database settings are configured in docker-compose.yml
# No need to set them here unless you're using external PostgreSQL
